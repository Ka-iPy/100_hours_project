<%- include('partials/header.ejs') %>

<main class="creator-page">
  <form id="characterForm" action="/createCharacter" method="POST" class="creator-wizard-layout">

    <!-- LEFT COLUMN: Stepper Progress Sidebar -->
    <aside class="creator-stepper-col">
      <div class="creator-stepper-panel">
        <div class="stepper-header">
          <h2 class="stepper-title">Hero Builder</h2>
          <p class="stepper-subtitle">Create your hero step-by-step</p>
          <div class="stepper-progress-container">
            <div class="stepper-progress-bar-bg">
              <div id="wizard-progress-bar" class="stepper-progress-bar-fill" style="width: 12.5%;"></div>
            </div>
            <div id="wizard-progress-text" class="stepper-progress-text">Step 1 of 8 (12%)</div>
          </div>
        </div>

        <nav class="stepper-nav">
          <button type="button" class="stepper-step-btn active" data-step="1" onclick="goToStep(1)">
            <span class="step-num-badge">1</span>
            <div class="step-label-container">
              <span class="step-label-title">Ruleset & Core</span>
              <span class="step-label-desc">Name & preferences</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="2" onclick="goToStep(2)">
            <span class="step-num-badge">2</span>
            <div class="step-label-container">
              <span class="step-label-title">Race</span>
              <span class="step-label-desc">Species & heritage</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="3" onclick="goToStep(3)">
            <span class="step-num-badge">3</span>
            <div class="step-label-container">
              <span class="step-label-title">Class</span>
              <span class="step-label-desc">Class & level</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="4" onclick="goToStep(4)">
            <span class="step-num-badge">4</span>
            <div class="step-label-container">
              <span class="step-label-title">Background</span>
              <span class="step-label-desc">Origin & alignment</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="5" onclick="goToStep(5)">
            <span class="step-num-badge">5</span>
            <div class="step-label-container">
              <span class="step-label-title">Ability Scores</span>
              <span class="step-label-desc">Point Buy / Array</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="6" onclick="goToStep(6)">
            <span class="step-num-badge">6</span>
            <div class="step-label-container">
              <span class="step-label-title">Equipment</span>
              <span class="step-label-desc">Starting gear</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="7" onclick="goToStep(7)">
            <span class="step-num-badge">7</span>
            <div class="step-label-container">
              <span class="step-label-title">Spells</span>
              <span class="step-label-desc">Cantrips & spells</span>
            </div>
          </button>
          <button type="button" class="stepper-step-btn" data-step="8" onclick="goToStep(8)">
            <span class="step-num-badge">8</span>
            <div class="step-label-container">
              <span class="step-label-title">Review</span>
              <span class="step-label-desc">Cerberus summary</span>
            </div>
          </button>
        </nav>
      </div>
    </aside>

    <!-- MIDDLE SECTION: Active Step Content Flanked by Full-Height Vertical Nav Buttons -->
    <div class="creator-middle-section">
      <!-- Left Side Prev Button -->
      <button type="button" id="wizard-btn-back" class="creator-side-nav-btn btn-prev" onclick="prevStep()" disabled title="Previous Step">
        <span class="nav-btn-icon">◀</span>
        <span class="nav-btn-label">PREV</span>
      </button>

      <!-- Main Content Panel -->
      <main class="creator-main-panel">
        <div class="creator-main-header">
          <h2 id="wizard-step-title" class="creator-step-title">1. Ruleset & Basic Info</h2>
          <span id="wizard-step-indicator" class="label-small">Step 1 / 8</span>
        </div>

        <div class="creator-main-body">
          <!-- STEP 1: Basic Info -->
          <div id="step-panel-1" class="wizard-step-panel">
            <div class="creator-field mb-4">
              <label for="name" class="font-bold block mb-1 text-gray-200">Character Name</label>
              <input type="text" id="name" name="name" class="w-full bg-slate-900 border border-slate-700 text-white rounded p-3" placeholder="Enter hero's name..." required>
            </div>
            <div class="creator-field">
              <label for="ruleset" class="font-bold block mb-1 text-gray-200">Edition / Ruleset Preference</label>
              <select id="ruleset" class="w-full bg-slate-900 border border-slate-700 text-white rounded p-3">
                <option value="5e">D&D 5e Standard Rules (PHB / XPHB / Expanded)</option>
                <option value="2024">2024 Revised Core Rules Preferred</option>
              </select>
            </div>
          </div>

          <!-- STEP 2: Race & Subrace -->
          <div id="step-panel-2" class="wizard-step-panel hidden">
            <!-- Subrace Container at Top (Sticky) -->
            <div id="subraceContainer" class="sticky -top-5 z-20 mb-3 p-3 bg-slate-900/95 backdrop-blur-md rounded-xl border border-yellow-500/50 shadow-xl hidden">
              <label for="subrace" class="font-bold block mb-1 text-yellow-500 text-xs uppercase tracking-wider">Select Subrace / Heritage Choice</label>
              <select id="subrace" name="subrace" class="w-full bg-slate-800 border border-slate-700 text-white rounded p-2 text-sm focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500" onchange="onSubraceChange()">
                <option value="">None</option>
              </select>
            </div>
            <div class="mb-4">
              <input type="text" id="race-search" class="w-full bg-slate-900 border border-slate-700 text-white rounded px-3 py-2 text-sm" placeholder="Search races (e.g. Dragonborn, Elf, Dwarf)..." oninput="filterRaces(this.value)">
              <input type="hidden" id="race" name="race" required>
            </div>
            <div id="race-cards-grid" class="creator-cards-grid pr-1">
              <!-- Dynamically rendered race cards -->
            </div>
          </div>

          <!-- STEP 3: Class & Level -->
          <div id="step-panel-3" class="wizard-step-panel hidden">
            <!-- Class Controls Header (Sticky) -->
            <div class="sticky -top-5 z-20 mb-4 p-3 bg-slate-900/95 backdrop-blur-md rounded-xl border border-slate-800 shadow-xl">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="level" class="font-bold block mb-1 text-gray-200 text-xs uppercase tracking-wider">Starting Level</label>
                  <input type="number" id="level" name="level" min="1" max="20" value="1" class="w-full bg-slate-800 border border-slate-700 text-white rounded p-2 text-sm font-bold" required onchange="onLevelChange()">
                </div>
                <div id="subclassContainer" class="hidden">
                  <label for="subclass" class="font-bold block mb-1 text-yellow-500 text-xs uppercase tracking-wider">Subclass Choice</label>
                  <select id="subclass" name="subclass" class="w-full bg-slate-800 border border-slate-700 text-white rounded p-2 text-sm focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500" onchange="onSubclassChange()">
                    <option value="">None</option>
                  </select>
                </div>
              </div>
            </div>
            <input type="hidden" id="className" name="className" required>
            <div id="class-cards-grid" class="creator-cards-grid pr-1">
              <!-- Dynamically rendered class cards -->
            </div>
          </div>

          <!-- STEP 4: Background & Alignment -->
          <div id="step-panel-4" class="wizard-step-panel hidden">
            <div class="mb-4">
              <label for="alignment" class="font-bold block mb-1 text-gray-200">Alignment</label>
              <select id="alignment" name="alignment" class="w-full bg-slate-900 border border-slate-700 text-white rounded p-2">
                <% alignments.forEach(align => { %>
                  <option value="<%= align %>"><%= align %></option>
                <% }) %>
              </select>
            </div>
            <input type="hidden" id="background" name="background" required>
            <div id="background-cards-grid" class="creator-cards-grid max-h-[300px] overflow-y-auto pr-1 mb-4">
              <!-- Dynamically rendered background cards -->
            </div>

            <!-- Feats Selection Section -->
            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800">
              <div class="flex justify-between items-center mb-2">
                <label class="font-bold text-yellow-500 text-sm">Select Feats (Optional / Origin Feats)</label>
                <span id="feat-counter" class="text-xs text-gray-400 font-semibold">0 selected</span>
              </div>
              <div class="mb-3">
                <input type="text" id="feat-search" class="w-full bg-slate-800 border border-slate-700 text-white rounded px-3 py-1.5 text-xs" placeholder="Search feats (e.g., Alert, Magic Initiate, Tough)..." oninput="filterFeats(this.value)">
              </div>
              <div id="feat-cards-grid" class="creator-cards-grid max-h-[220px] overflow-y-auto pr-1">
                <!-- Dynamically rendered feat cards -->
              </div>
            </div>
          </div>

          <!-- STEP 5: Ability Scores (Point Buy, Standard Array, Manual) -->
          <div id="step-panel-5" class="wizard-step-panel hidden">
            <div class="flex gap-2 mb-4">
              <button type="button" class="rpg-btn rpg-btn-secondary text-xs active" id="btn-mode-pointbuy" onclick="setAbilityMode('pointbuy')">Point Buy (27 pts)</button>
              <button type="button" class="rpg-btn rpg-btn-secondary text-xs" id="btn-mode-array" onclick="setAbilityMode('array')">Standard Array</button>
              <button type="button" class="rpg-btn rpg-btn-secondary text-xs" id="btn-mode-manual" onclick="setAbilityMode('manual')">Manual Roll</button>
            </div>
            <div id="pointbuy-tracker" class="p-3 bg-slate-900/60 rounded border border-slate-800 mb-4 flex justify-between items-center text-sm font-bold text-yellow-400">
              <span>Points Remaining: <span id="points-left">27</span> / 27</span>
              <span class="text-xs text-gray-400 font-normal">Costs: 8=0, 9=1, 10=2, 11=3, 12=4, 13=5, 14=7, 15=9</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              <% abilities.forEach(ability => {
                const displayName = ability.charAt(0).toUpperCase() + ability.slice(1); %>
                <div class="creator-ability-card p-3 bg-slate-900/50 rounded-xl border border-slate-800">
                  <label for="stat_<%= ability %>" class="font-bold text-sm text-gray-200 block mb-1"><%= displayName %></label>
                  <div class="flex items-center gap-2">
                    <input type="number" id="stat_<%= ability %>" name="stats[<%= ability %>]" min="1" max="20" value="10"
                      class="w-16 text-center bg-slate-800 border border-slate-700 text-white rounded p-1 font-bold text-lg"
                      onchange="onStatChange('<%= ability %>')">
                    <div class="text-xs text-gray-400">
                      <div>Base: <span id="base_<%= ability %>">10</span></div>
                      <div class="text-emerald-400 font-bold">Racial: <span id="asi_<%= ability %>">+0</span></div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- STEP 6: Equipment -->
          <div id="step-panel-6" class="wizard-step-panel hidden">
            <div id="equipmentSummary" class="mb-3"></div>
            <div id="equipmentChoices"></div>
            <div id="equipmentGoldAlt" class="creator-gold-alt mt-4"></div>
          </div>

          <!-- STEP 7: Spells -->
          <div id="step-panel-7" class="wizard-step-panel hidden">
            <div id="spellInfo" class="mb-4"></div>
            <div id="cantripSection" style="display: none;">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold text-sm text-yellow-500">Cantrips</h3>
                <span id="cantripCounter" class="spell-count-badge"></span>
              </div>
              <div id="cantripList" class="creator-pick-grid"></div>
            </div>
            <div id="spellPickSection" style="display: none;" class="mt-4">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold text-sm text-yellow-500">Prepared / Known Spells</h3>
                <span id="spellCounter" class="spell-count-badge"></span>
              </div>
              <input type="text" id="spellSearch" class="spell-search mb-3" placeholder="Search spells by name…">
              <div id="spellSummary" class="flex flex-wrap gap-2 mb-3"></div>
              <div id="spellList" class="space-y-4"></div>
            </div>
          </div>

          <!-- STEP 8: Review & Cerberus -->
          <div id="step-panel-8" class="wizard-step-panel hidden space-y-4">
            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800">
              <h3 class="font-bold text-lg text-yellow-500 mb-2">Character Summary</h3>
              <div id="review-summary-grid" class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                <!-- Dynamically populated summary -->
              </div>
            </div>
            <div class="p-4 bg-purple-950/30 rounded-xl border border-purple-800/40">
              <h3 class="font-bold text-sm text-purple-400 mb-1">Cerberus Watchdog Inspection</h3>
              <p class="text-xs text-gray-400 mb-2">Real-time analysis of auto-granted traits, stat increases, and proficiencies.</p>
              <div id="cerberus-review-box" class="text-xs text-gray-300 space-y-1">
                <!-- Dynamically populated Cerberus watchdog breakdown -->
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Right Side Next / Submit Button -->
      <div class="creator-side-nav-right">
        <button type="button" id="wizard-btn-next" class="creator-side-nav-btn btn-next" onclick="nextStep()" title="Next Step">
          <span class="nav-btn-label">NEXT</span>
          <span class="nav-btn-icon">▶</span>
        </button>
        <button type="submit" id="wizard-btn-submit" class="creator-side-nav-btn btn-submit hidden" title="Create Character">
          <span class="nav-btn-label">CREATE</span>
          <span class="nav-btn-icon">✨</span>
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: Dynamic Live Inspector Panel -->
    <aside class="creator-inspector-col">
      <div class="creator-inspector-panel" id="inspector-panel">
        <div class="inspector-empty">
          <p>Select any Race, Class, or Background option card to inspect details, traits, and Ability Score Increases.</p>
        </div>
      </div>
    </aside>

  </form>

  <div id="characterPreview" class="creator-preview hidden">
    <h2>Character Preview</h2>
    <pre id="characterJson"></pre>
  </div>
</main>

<script type="module">
  import { Tags, Parser } from '/utils/parser.js';
  window.Tags = Tags;
  window.Parser = Parser;
</script>

<script>
  // Raw Data Passed from Express
  const rawRaces = [<%- races.join(',') %>];
  const rawSubraces = [<%- subraces.join(',') %>];
  const rawClasses = [<%- classes.join(',') %>];
  const rawSubclasses = [<%- subclasses.join(',') %>];
  const rawBackgrounds = [<%- backgrounds.join(',') %>];
  const allFeats = [<%- feats.join(',') %>];

  // Wizard Step Navigation State
  window.currentStep = 1;
  const maxSteps = 8;

  // Ability Score Calculation State
  let abilityMode = 'pointbuy';
  const pointCosts = { 8: 0, 9: 1, 10: 2, 11: 3, 12: 4, 13: 5, 14: 7, 15: 9 };
  const standardArray = [15, 14, 13, 12, 10, 8];

  // Selected Entity State
  let selectedRaceObj = null;
  let selectedSubraceObj = null;
  let selectedClassObj = null;
  let selectedSubclassObj = null;
  let selectedBackgroundObj = null;

  let selectedFeats = [];
  let selectedCantrips = [];
  let selectedSpells = [];
  let selectedEquipmentChoices = [];
  const equipChoicesByGroup = {};
  let spellContextData = null;

  const ABILITIES = ['strength', 'dexterity', 'constitution', 'intelligence', 'wisdom', 'charisma'];
  const ABIL_MAP = { str: 'strength', dex: 'dexterity', con: 'constitution', int: 'intelligence', wis: 'wisdom', cha: 'charisma' };

  function safeParse(val) {
    if (!val) return null;
    if (typeof val === 'object') return val;
    try { return JSON.parse(val); } catch (e) { return null; }
  }

  // Exposed Navigation Methods
  window.updateWizardUI = function() {
    document.querySelectorAll('.stepper-step-btn').forEach(btn => {
      const step = parseInt(btn.dataset.step);
      btn.classList.remove('active');
      if (step === window.currentStep) {
        btn.classList.add('active');
      }
      if (step < window.currentStep) {
        btn.classList.add('completed');
      }
    });

    const pct = Math.round((window.currentStep / maxSteps) * 100);
    document.getElementById('wizard-progress-bar').style.width = pct + '%';
    document.getElementById('wizard-progress-text').textContent = `Step ${window.currentStep} of ${maxSteps} (${pct}%)`;

    for (let i = 1; i <= maxSteps; i++) {
      const panel = document.getElementById(`step-panel-${i}`);
      if (panel) {
        if (i === window.currentStep) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      }
    }

    const stepTitles = {
      1: '1. Ruleset & Basic Info',
      2: '2. Select Race & Heritage',
      3: '3. Select Class & Level',
      4: '4. Select Background & Alignment',
      5: '5. Ability Scores & Racial ASIs',
      6: '6. Starting Equipment',
      7: '7. Spellcasting Selection',
      8: '8. Review & Cerberus Inspection'
    };
    document.getElementById('wizard-step-title').textContent = stepTitles[window.currentStep] || '';
    document.getElementById('wizard-step-indicator').textContent = `Step ${window.currentStep} / ${maxSteps}`;

    document.getElementById('wizard-btn-back').disabled = (window.currentStep === 1);
    if (window.currentStep === maxSteps) {
      document.getElementById('wizard-btn-next').classList.add('hidden');
      document.getElementById('wizard-btn-submit').classList.remove('hidden');
      renderReviewStep();
    } else {
      document.getElementById('wizard-btn-next').classList.remove('hidden');
      document.getElementById('wizard-btn-submit').classList.add('hidden');
    }

    if (window.currentStep === 6) loadEquipmentStep();
    if (window.currentStep === 7) loadSpellsStep();
  };

  window.goToStep = function(step) {
    if (step >= 1 && step <= maxSteps) {
      window.currentStep = step;
      window.updateWizardUI();
    }
  };

  window.nextStep = function() {
    if (window.currentStep < maxSteps) {
      window.currentStep++;
      window.updateWizardUI();
    }
  };

  window.prevStep = function() {
    if (window.currentStep > 1) {
      window.currentStep--;
      window.updateWizardUI();
    }
  };

  // Card Renderers & Selections
  function renderRaceCards() {
    const grid = document.getElementById('race-cards-grid');
    if (!grid) return;
    grid.innerHTML = '';

    rawRaces.forEach(r => {
      const card = document.createElement('div');
      card.className = 'creator-option-card';
      if (selectedRaceObj && selectedRaceObj.name === r.name && selectedRaceObj.source === r.source) {
        card.classList.add('selected');
      }
      card.onclick = () => selectRace(r);

      const snippet = r.entries ? flattenEntries(r.entries) : 'Racial traits & heritage choices.';
      card.innerHTML = `
        <div class="card-title-row">
          <span class="card-name">${r.name}</span>
          <span class="source-tag">${r.source}</span>
        </div>
        <div class="card-snippet">${snippet}</div>
      `;
      grid.appendChild(card);
    });
  }

  window.filterRaces = function(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#race-cards-grid .creator-option-card').forEach((card, idx) => {
      const r = rawRaces[idx];
      if (r.name.toLowerCase().includes(q) || r.source.toLowerCase().includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  };

  function selectRace(rData) {
    selectedRaceObj = rData;
    document.getElementById('race').value = JSON.stringify(rData);

    renderRaceCards();
    inspectEntity(rData, 'Race');
    updateSubraces(rData);
    calculateRacialASIs();
  }

  function updateSubraces(rData) {
    const select = document.getElementById('subrace');
    const container = document.getElementById('subraceContainer');
    select.innerHTML = '<option value="">None / Standard</option>';

    const matchingSubraces = rawSubraces.filter(sr => 
      sr.raceName?.toLowerCase() === rData.name?.toLowerCase()
    );

    if (matchingSubraces.length > 0) {
      container.classList.remove('hidden');
      matchingSubraces.forEach(sr => {
        const opt = document.createElement('option');
        opt.value = JSON.stringify(sr);
        opt.textContent = `${sr.name} (${sr.source})`;
        select.appendChild(opt);
      });
    } else {
      container.classList.add('hidden');
    }
  }

  window.onSubraceChange = function() {
    const val = document.getElementById('subrace').value;
    selectedSubraceObj = val ? safeParse(val) : null;
    calculateRacialASIs();
    if (selectedSubraceObj) {
      inspectEntity(selectedSubraceObj, 'Subrace');
    }
  };

  function renderClassCards() {
    const grid = document.getElementById('class-cards-grid');
    if (!grid) return;
    grid.innerHTML = '';

    rawClasses.forEach(c => {
      const card = document.createElement('div');
      card.className = 'creator-option-card';
      if (selectedClassObj && selectedClassObj.name === c.name && selectedClassObj.source === c.source) {
        card.classList.add('selected');
      }
      card.onclick = () => selectClass(c);

      card.innerHTML = `
        <div class="card-title-row">
          <span class="card-name">${c.name}</span>
          <span class="source-tag">${c.source}</span>
        </div>
        <div class="text-xs text-indigo-400 font-bold mt-1">Hit Die: d${c.hd?.faces || 8}</div>
        <div class="card-snippet">Primary Ability: ${c.proficiency ? c.proficiency.join(', ') : 'Various'}</div>
      `;
      grid.appendChild(card);
    });
  }

  function selectClass(cData) {
    selectedClassObj = cData;
    document.getElementById('className').value = JSON.stringify(cData);

    renderClassCards();
    inspectEntity(cData, 'Class');
    updateSubclasses(cData);
  }

  function updateSubclasses(cData) {
    const select = document.getElementById('subclass');
    const container = document.getElementById('subclassContainer');
    select.innerHTML = '<option value="">None / Primary</option>';

    const matchingSubclasses = rawSubclasses.filter(sc => 
      sc.className?.toLowerCase() === cData.name?.toLowerCase()
    );

    if (matchingSubclasses.length > 0) {
      container.classList.remove('hidden');
      matchingSubclasses.forEach(sc => {
        const opt = document.createElement('option');
        opt.value = JSON.stringify(sc);
        opt.textContent = `${sc.name} (${sc.source})`;
        select.appendChild(opt);
      });
    } else {
      container.classList.add('hidden');
    }
  }

  window.onSubclassChange = function() {
    const val = document.getElementById('subclass').value;
    selectedSubclassObj = val ? safeParse(val) : null;
    if (selectedSubclassObj) {
      inspectEntity(selectedSubclassObj, 'Subclass');
    }
  };

  window.onLevelChange = function() {
    if (selectedClassObj) updateSubclasses(selectedClassObj);
  };

  function renderBackgroundCards() {
    const grid = document.getElementById('background-cards-grid');
    if (!grid) return;
    grid.innerHTML = '';

    rawBackgrounds.forEach(b => {
      const card = document.createElement('div');
      card.className = 'creator-option-card';
      if (selectedBackgroundObj && selectedBackgroundObj.name === b.name && selectedBackgroundObj.source === b.source) {
        card.classList.add('selected');
      }
      card.onclick = () => selectBackground(b);

      const snippet = b.entries ? flattenEntries(b.entries) : 'Background feature and proficiencies.';
      card.innerHTML = `
        <div class="card-title-row">
          <span class="card-name">${b.name}</span>
          <span class="source-tag">${b.source}</span>
        </div>
        <div class="card-snippet">${snippet}</div>
      `;
      grid.appendChild(card);
    });
  }

  function selectBackground(bData) {
    selectedBackgroundObj = bData;
    document.getElementById('background').value = JSON.stringify(bData);

    renderBackgroundCards();
    inspectEntity(bData, 'Background');
  }

  // Live Inspector Drawer
  function cleanTags(str) {
    if (!str || typeof str !== 'string') return str || '';
    let text = str;
    if (window.Tags && typeof window.Tags.cleanTags === 'function') {
      text = window.Tags.cleanTags(str);
    }
    if (typeof window.renderMarkdown === 'function') {
      return window.renderMarkdown(text);
    }
    return text;
  }

  function inspectEntity(data, type) {
    const panel = document.getElementById('inspector-panel');
    if (!data || !panel) return;

    const name = data.name || data.sourceName || 'Option Detail';
    const source = data.source || 'PHB';

    let badgesHTML = `<span class="inspector-badge-pill">${type}</span>`;
    badgesHTML += `<span class="inspector-badge-pill">Source: ${source}</span>`;

    if (data.category) {
      badgesHTML += `<span class="inspector-badge-pill">Category: ${data.category}</span>`;
    }
    if (data.speed) {
      const spd = typeof data.speed === 'object' ? data.speed.walk : data.speed;
      badgesHTML += `<span class="inspector-badge-pill">Speed: ${spd} ft</span>`;
    }
    if (data.size) {
      const sz = Array.isArray(data.size) ? data.size.join('/') : data.size;
      badgesHTML += `<span class="inspector-badge-pill">Size: ${sz}</span>`;
    }
    if (data.hd) {
      badgesHTML += `<span class="inspector-badge-pill">Hit Die: d${data.hd.faces}</span>`;
    }

    let asiHTML = '';
    if (data.ability) {
      const chips = [];
      const abList = Array.isArray(data.ability) ? data.ability : [data.ability];
      abList.forEach(abObj => {
        if (typeof abObj === 'object') {
          Object.entries(abObj).forEach(([st, val]) => {
            if (st !== 'choose' && typeof val === 'number') {
              chips.push(`<span class="asi-chip">${st.toUpperCase()} +${val}</span>`);
            } else if (st === 'choose') {
              chips.push(`<span class="asi-chip">+1 to choice</span>`);
            }
          });
        }
      });
      if (chips.length > 0) {
        asiHTML = `
          <div class="inspector-asi-box">
            <div class="inspector-asi-title">Ability Score Increases</div>
            <div class="inspector-asi-chips">${chips.join('')}</div>
          </div>
        `;
      }
    }

    let detailsHTML = '';

    if (type === 'Class') {
      const saves = data.proficiency ? data.proficiency.map(p => p.toUpperCase()).join(', ') : 'None';
      const armors = data.startingProficiencies?.armor ? data.startingProficiencies.armor.map(a => cleanTags(a)).join(', ') : 'None';
      const weapons = data.startingProficiencies?.weapons ? data.startingProficiencies.weapons.map(w => typeof w === 'string' ? cleanTags(w) : (w.proficiency || 'Custom')).join(', ') : 'None';
      const tools = data.startingProficiencies?.tools ? data.startingProficiencies.tools.map(t => cleanTags(t)).join(', ') : 'None';
      const caster = data.spellcastingAbility ? data.spellcastingAbility.toUpperCase() : 'Non-caster';

      detailsHTML = `
        <div class="space-y-2 text-xs text-gray-300">
          <div><strong class="text-indigo-400">Saving Throws:</strong> ${saves}</div>
          <div><strong class="text-indigo-400">Armor Proficiencies:</strong> ${armors}</div>
          <div><strong class="text-indigo-400">Weapon Proficiencies:</strong> ${weapons}</div>
          <div><strong class="text-indigo-400">Tool Proficiencies:</strong> ${tools}</div>
          <div><strong class="text-indigo-400">Spellcasting Ability:</strong> ${caster}</div>
        </div>
      `;
    } else if (type === 'Background') {
      const skills = data.skillProficiencies ? data.skillProficiencies.map(s => Object.keys(s).filter(k => k !== 'choose').join(', ')).filter(Boolean).join(', ') : 'Custom';
      const tools = data.toolProficiencies ? data.toolProficiencies.map(t => Object.keys(t).filter(k => k !== 'choose').join(', ')).filter(Boolean).join(', ') : 'None';

      const entryText = data.entries ? flattenEntries(data.entries) : (data.description || 'Standard background feature.');
      detailsHTML = `
        <div class="space-y-2 text-xs text-gray-300">
          <div><strong class="text-yellow-500">Skills Granted:</strong> ${skills || 'Selection'}</div>
          ${tools ? `<div><strong class="text-yellow-500">Tools Granted:</strong> ${tools}</div>` : ''}
          <div class="border-t border-slate-800 pt-2 mt-2">${entryText}</div>
        </div>
      `;
    } else if (type === 'Feat') {
      let prereqText = '';
      if (data.prerequisite) {
        prereqText = data.prerequisite.map(p => {
          if (p.ability) return 'Prereq: ' + p.ability.map(a => Object.keys(a).join('/').toUpperCase()).join(', ');
          if (p.level) return 'Prereq: Level ' + p.level;
          if (p.spellcasting) return 'Prereq: Spellcasting ability';
          return '';
        }).filter(Boolean).join(' | ');
      }
      const entryText = data.entries ? flattenEntries(data.entries) : (data.description || 'Feat benefits & rules.');
      detailsHTML = `
        <div class="space-y-2 text-xs text-gray-300">
          ${prereqText ? `<div class="text-amber-400 font-semibold">${prereqText}</div>` : ''}
          <div class="border-t border-slate-800 pt-2 mt-2 leading-relaxed">${entryText}</div>
        </div>
      `;
    } else {
      const entryText = data.entries ? flattenEntries(data.entries) : (data.description || 'Racial traits & heritage details.');
      detailsHTML = `<div class="text-xs text-gray-300 leading-relaxed">${entryText}</div>`;
    }

    panel.innerHTML = `
      <div>
        <h3 class="inspector-header-title">${name}</h3>
        <div class="inspector-badges-row">${badgesHTML}</div>
      </div>
      ${asiHTML}
      <div class="text-xs text-gray-300 leading-relaxed space-y-2 border-t border-slate-800 pt-3">
        <div class="font-bold text-gray-400 uppercase text-[10px] tracking-wider">Description & Features</div>
        <div>${detailsHTML}</div>
      </div>
    `;
  }

  function flattenEntries(entries) {
    if (!entries) return '';
    if (typeof entries === 'string') return cleanTags(entries);
    if (Array.isArray(entries)) {
      return entries.map(e => {
        if (typeof e === 'string') return cleanTags(e);
        let out = '';
        if (e.name) out += '<div class="font-bold text-yellow-500 mt-2">' + cleanTags(e.name) + '</div>';
        if (e.entry) out += '<div>' + cleanTags(e.entry) + '</div>';
        if (e.entries) out += '<div>' + flattenEntries(e.entries) + '</div>';
        if (e.items) {
          out += '<ul class="list-disc pl-4 space-y-1 my-1">' + e.items.map(it => {
            if (typeof it === 'string') return '<li>' + cleanTags(it) + '</li>';
            if (it.name) return '<li><strong>' + cleanTags(it.name) + ':</strong> ' + flattenEntries(it.entry || it.entries) + '</li>';
            return '<li>' + flattenEntries(it) + '</li>';
          }).join('') + '</ul>';
        }
        return out;
      }).join('');
    }
    return '';
  }

  // Feat Cards Renderer & Filter
  function renderFeatCards() {
    const grid = document.getElementById('feat-cards-grid');
    if (!grid) return;
    grid.innerHTML = '';

    allFeats.forEach(f => {
      const card = document.createElement('div');
      card.className = 'creator-option-card';
      const isSelected = selectedFeats.some(sf => sf.name === f.name && sf.source === f.source);
      if (isSelected) card.classList.add('selected');

      card.onclick = () => toggleFeat(f);

      const snippet = f.entries ? flattenEntries(f.entries) : (f.category ? `Category: ${f.category}` : 'Feat choice');
      card.innerHTML = `
        <div class="card-title-row">
          <span class="card-name">${f.name}</span>
          <span class="source-tag">${f.source}</span>
        </div>
        <div class="card-snippet">${snippet}</div>
      `;
      grid.appendChild(card);
    });
  }

  window.filterFeats = function(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#feat-cards-grid .creator-option-card').forEach((card, idx) => {
      const f = allFeats[idx];
      if (f && (f.name.toLowerCase().includes(q) || f.source.toLowerCase().includes(q))) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  };

  function toggleFeat(fData) {
    const idx = selectedFeats.findIndex(sf => sf.name === fData.name && sf.source === fData.source);
    if (idx >= 0) {
      selectedFeats.splice(idx, 1);
    } else {
      selectedFeats.push(fData);
    }
    const counter = document.getElementById('feat-counter');
    if (counter) counter.textContent = `${selectedFeats.length} selected`;
    renderFeatCards();
    inspectEntity(fData, 'Feat');
  }

  // Ability Score & Point Buy Logic
  function calculateRacialASIs() {
    const asiTotals = { strength: 0, dexterity: 0, constitution: 0, intelligence: 0, wisdom: 0, charisma: 0 };

    const applyAbilities = (dataObj) => {
      if (dataObj && dataObj.ability) {
        dataObj.ability.forEach(abObj => {
          Object.entries(abObj).forEach(([st, val]) => {
            if (st !== 'choose' && typeof val === 'number') {
              const key = ABIL_MAP[st.toLowerCase()] || st.toLowerCase();
              if (asiTotals.hasOwnProperty(key)) {
                asiTotals[key] += val;
              }
            }
          });
        });
      }
    };

    applyAbilities(selectedRaceObj);
    applyAbilities(selectedSubraceObj);

    ABILITIES.forEach(st => {
      const bonus = asiTotals[st] || 0;
      const el = document.getElementById(`asi_${st}`);
      if (el) el.textContent = bonus > 0 ? `+${bonus}` : `+0`;
    });
  }

  window.setAbilityMode = function(mode) {
    abilityMode = mode;
    document.querySelectorAll('#step-panel-5 .rpg-btn').forEach(btn => btn.classList.remove('active'));
    const targetBtn = document.getElementById(`btn-mode-${mode}`);
    if (targetBtn) targetBtn.classList.add('active');

    const tracker = document.getElementById('pointbuy-tracker');
    if (mode === 'pointbuy') {
      if (tracker) tracker.classList.remove('hidden');
      resetPointBuy();
    } else if (mode === 'array') {
      if (tracker) tracker.classList.add('hidden');
      ABILITIES.forEach((st, i) => {
        const el = document.getElementById(`stat_${st}`);
        const baseEl = document.getElementById(`base_${st}`);
        if (el) el.value = standardArray[i];
        if (baseEl) baseEl.textContent = standardArray[i];
      });
    } else {
      if (tracker) tracker.classList.add('hidden');
    }
  };

  function resetPointBuy() {
    ABILITIES.forEach(st => {
      const el = document.getElementById(`stat_${st}`);
      const baseEl = document.getElementById(`base_${st}`);
      if (el) el.value = 8;
      if (baseEl) baseEl.textContent = 8;
    });
    updatePointBuy();
  }

  function updatePointBuy() {
    if (abilityMode !== 'pointbuy') return;
    let spent = 0;

    ABILITIES.forEach(st => {
      const el = document.getElementById(`stat_${st}`);
      const val = parseInt(el?.value) || 8;
      spent += (pointCosts[val] !== undefined ? pointCosts[val] : 0);
      const baseEl = document.getElementById(`base_${st}`);
      if (baseEl) baseEl.textContent = val;
    });

    const remaining = 27 - spent;
    const trackerEl = document.getElementById('points-left');
    if (trackerEl) trackerEl.textContent = remaining;
  }

  window.onStatChange = function(statKey) {
    const el = document.getElementById(`stat_${statKey}`);
    const baseEl = document.getElementById(`base_${statKey}`);
    if (el && baseEl) baseEl.textContent = el.value;
    if (abilityMode === 'pointbuy') updatePointBuy();
  };

  /**
   * Compute the ability modifier for the class's spellcasting ability.
   * Uses the base score from the stat inputs + racial ASIs.
   */
  function getSpellcastingAbilityMod(rawAbility) {
    if (!rawAbility) return 0;
    // Map short ability name ("int", "wis", "cha") to full name
    const fullName = ABIL_MAP[rawAbility.toLowerCase()] || rawAbility.toLowerCase();
    const baseEl = document.getElementById(`stat_${fullName}`);
    const asiEl = document.getElementById(`asi_${fullName}`);
    const baseScore = parseInt(baseEl?.value) || 10;
    const asiBonus = parseInt(asiEl?.textContent) || 0;
    const totalScore = baseScore + asiBonus;
    return Math.floor((totalScore - 10) / 2);
  }

  // Step 6: Interactive Equipment Loader
  async function loadEquipmentStep() {
    const container = document.getElementById('equipmentChoices');
    if (!container) return;

    if (!selectedClassObj) {
      container.innerHTML = '<div class="text-gray-400 italic p-4 bg-slate-900/60 rounded-xl border border-slate-800">Select a Class in Step 3 first.</div>';
      return;
    }

    container.innerHTML = '<div class="text-gray-400 italic p-4 bg-slate-900/60 rounded-xl border border-slate-800 animate-pulse">Loading class starting equipment options...</div>';

    try {
      const res = await fetch(`/api/equipment/class/${encodeURIComponent(selectedClassObj.name)}?classSource=${encodeURIComponent(selectedClassObj.source || 'PHB')}`);
      if (!res.ok) throw new Error('Failed to load equipment');
      const data = await res.json();

      if (!data.choices || data.choices.length === 0) {
        container.innerHTML = `<div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 text-sm text-gray-300">Standard starting equipment will be assigned for ${selectedClassObj.name}.</div>`;
        selectedEquipmentChoices = [];
        Object.keys(equipChoicesByGroup).forEach(k => delete equipChoicesByGroup[k]);
        return;
      }

      let html = `<div class="font-bold text-yellow-500 mb-3 text-sm">Starting Equipment Options for ${selectedClassObj.name}</div>`;
      html += '<div id="equipmentGroups" class="space-y-4">';
      html += renderEquipmentGroups(data);
      html += '</div>';

      container.innerHTML = html;
      renderEquipmentSummary(data);
    } catch (err) {
      console.error(err);
      container.innerHTML = `<div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 text-sm text-gray-400">Standard starting equipment will be provided automatically.</div>`;
    }
  }

  let lastEquipmentData = null;

  function equipItemName(it) {
    return cleanTags(it.name).replace(/<\/?p[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function equipItemMetaChips(it) {
    const P = window.Parser;
    const chips = [];
    if (P && it.data) {
      if (it.data.weight) {
        const w = P.itemWeightToFull({ weight: it.data.weight });
        if (w) chips.push(`<span class="spell-meta-chip">⚖ ${w}</span>`);
      }
      if (it.data.value) {
        const v = P.itemValueToFull({ value: it.data.value }, { isShortForm: true });
        if (v) chips.push(`<span class="spell-meta-chip">◎ ${v}</span>`);
      }
    }
    return chips.join('');
  }

  function renderEquipmentGroups(data) {
    lastEquipmentData = data;
    let html = '';

    data.choices.forEach((choiceGroup, groupIdx) => {
      const cleanGroupText = choiceGroup.text ? cleanTags(choiceGroup.text) : `Choose one of the following`;
      html += `<div class="equip-group">`;
      html += `<div class="equip-group-head"><span class="equip-group-num">${groupIdx + 1}</span><span class="equip-group-text">${cleanGroupText}</span></div>`;

      if (choiceGroup.isAutomatic && choiceGroup.options.length > 0) {
        const chips = choiceGroup.options[0].items.map(it =>
          `<span class="equip-item-chip">${equipItemName(it)}${it.quantity > 1 ? ` <span class="equip-qty">×${it.quantity}</span>` : ''}</span>`
        ).join('');
        html += `<div class="equip-granted-card"><span class="equip-granted-icon">✔</span><span class="equip-granted-items">${chips}</span></div>`;
        equipChoicesByGroup[groupIdx] = { groupIndex: groupIdx, choiceKey: '_' };
      } else {
        const selectedKey = equipChoicesByGroup[groupIdx]?.choiceKey;
        html += `<div class="space-y-2">`;
        choiceGroup.options.forEach((opt, optIdx) => {
          const selected = selectedKey ? selectedKey === opt.key : optIdx === 0;
          if (!selectedKey && optIdx === 0) {
            equipChoicesByGroup[groupIdx] = { groupIndex: groupIdx, choiceKey: opt.key };
          }
          const itemNames = opt.items.map(it =>
            `<span>${equipItemName(it)}${it.quantity > 1 ? `<span class="equip-qty"> ×${it.quantity}</span>` : ''}</span>`
          ).join('<span class="equip-item-sep"> + </span>');
          const meta = opt.items.map(equipItemMetaChips).join('');
          html += `
            <label class="equip-option-card ${selected ? 'selected' : ''}">
              <input type="radio" name="equip_group_${groupIdx}" value='${opt.key}' ${selected ? 'checked' : ''} onchange="onEquipmentChoiceChange(${groupIdx}, this.value)" class="sr-only">
              <span class="equip-letter-badge">${opt.key.toUpperCase()}</span>
              <span class="equip-option-body">
                <span class="equip-option-items">${itemNames}</span>
                ${meta ? `<span class="spell-meta">${meta}</span>` : ''}
              </span>
              <span class="spell-card-check">✓</span>
            </label>
          `;
        });
        html += `</div>`;
      }
      html += `</div>`;
    });

    const goldAlt = document.getElementById('equipmentGoldAlt');
    if (goldAlt) {
      goldAlt.innerHTML = data.goldAlternative
        ? `<div class="equip-gold-alt">🪙 Gold Alternative: ${cleanTags(data.goldAlternative)}</div>`
        : '';
    }

    return html;
  }

  function renderEquipmentSummary(data) {
    const summaryEl = document.getElementById('equipmentSummary');
    if (!summaryEl) return;
    const parts = [];
    (data.choices || []).forEach((choiceGroup, groupIdx) => {
      const choice = equipChoicesByGroup[groupIdx];
      if (!choice) return;
      const group = choiceGroup.options.find(o => o.key === choice.choiceKey);
      if (!group) return;
      group.items.forEach(it => parts.push(`${equipItemName(it)}${it.quantity > 1 ? ` ×${it.quantity}` : ''}`));
    });
    summaryEl.innerHTML = parts.length
      ? `<span class="spell-level-head"><span class="spell-pips">◆</span> Selected Equipment: <span class="text-gray-300 font-medium">${parts.join(' + ')}</span></span>`
      : '';
  }

  window.onEquipmentChoiceChange = function(groupIdx, choiceKey) {
    if (!choiceKey) return;
    equipChoicesByGroup[groupIdx] = { groupIndex: groupIdx, choiceKey };
    selectedEquipmentChoices = Object.values(equipChoicesByGroup);
    if (lastEquipmentData) {
      const groupsEl = document.getElementById('equipmentGroups');
      if (groupsEl) groupsEl.innerHTML = renderEquipmentGroups(lastEquipmentData);
      renderEquipmentSummary(lastEquipmentData);
    }
  };

  // Step 7: Dynamic Spell & Cantrip Selection
  async function loadSpellsStep() {
    const info = document.getElementById('spellInfo');
    const cantripSec = document.getElementById('cantripSection');
    const spellPickSec = document.getElementById('spellPickSection');
    if (!info) return;

    if (!selectedClassObj) {
      info.innerHTML = '<div class="text-gray-400 italic p-4 bg-slate-900/60 rounded-xl border border-slate-800">Select a Class in Step 3 first.</div>';
      if (cantripSec) cantripSec.style.display = 'none';
      if (spellPickSec) spellPickSec.style.display = 'none';
      return;
    }

    const level = parseInt(document.getElementById('level')?.value) || 1;
    const subclassName = selectedSubclassObj ? selectedSubclassObj.name : '';
    const subclassSource = selectedSubclassObj ? selectedSubclassObj.source : '';

    info.innerHTML = '<div class="text-gray-400 italic p-4 bg-slate-900/60 rounded-xl border border-slate-800 animate-pulse">Loading spellcasting context...</div>';

    try {
      // Compute the spellcasting ability modifier from the user's ability scores
      // We need to know the class's spellcasting ability first — fetch with mod=0 to get the ability key,
      // but since we know common mappings, compute it eagerly
      const classData = rawClasses.find(c => c.name === selectedClassObj.name && c.source === (selectedClassObj.source || 'PHB'));
      const rawAbility = classData?.spellcastingAbility || 'int';
      const abilityMod = getSpellcastingAbilityMod(rawAbility);

      const url = `/api/spells/context/${encodeURIComponent(selectedClassObj.name)}/${level}?classSource=${encodeURIComponent(selectedClassObj.source || 'PHB')}&subclassName=${encodeURIComponent(subclassName)}&subclassSource=${encodeURIComponent(subclassSource)}&abilityMod=${abilityMod}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error('Failed to fetch spell context');
      spellContextData = await res.json();

      if (!spellContextData || !spellContextData.isCaster) {
        info.innerHTML = `
          <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 text-sm space-y-1">
            <div class="font-bold text-gray-300">🛡️ Non-Spellcasting Class</div>
            <p class="text-xs text-gray-400"><strong>${selectedClassObj.name}</strong> (level ${level}) does not prepare spells at this level. You may proceed to Review.</p>
          </div>
        `;
        if (cantripSec) cantripSec.style.display = 'none';
        if (spellPickSec) spellPickSec.style.display = 'none';
        selectedCantrips = [];
        selectedSpells = [];
        return;
      }

      // Build acquisition type description
      const acqType = spellContextData.acquisitionType || 'known';
      const numSelectable = spellContextData.numSelectable || spellContextData.maxSpells || 0;
      const numPrepared = spellContextData.numPrepared || 0;
      const abilityLabel = (spellContextData.ability || 'INT').toUpperCase();

      // Half-casters (Paladin/Ranger) gain spellcasting at level 2
      const totalAvailableSpells = Object.values(spellContextData.spellList || {}).reduce((sum, list) => sum + (Array.isArray(list) ? list.length : 0), 0);
      const hasNoSlotsYet = Object.keys(spellContextData.slots || {}).length === 0;
      const gainsSpellcastingLater = totalAvailableSpells === 0 && hasNoSlotsYet && (spellContextData.cantripList || []).length === 0;

      let acqDescription = '';
      if (gainsSpellcastingLater) {
        acqDescription = `<div class="text-xs text-sky-300 mt-1">⏳ <strong>${selectedClassObj.name}</strong> gains spellcasting at <strong>level 2</strong> — you have no spells to prepare at this level.</div>`;
      } else if (acqType === 'spellbook') {
        acqDescription = `<div class="text-xs text-amber-300 mt-1">📖 <strong>Spellbook:</strong> Choose <strong>${numSelectable}</strong> spells for your spellbook. You can prepare <strong>${numPrepared}</strong> daily (Level + ${abilityLabel} mod).</div>`;
      } else if (acqType === 'prepared_formula') {
        acqDescription = `<div class="text-xs text-sky-300 mt-1">📋 <strong>Prepared Caster:</strong> Choose <strong>${numSelectable}</strong> spells to prepare from all ${selectedClassObj.name} spells (Level + ${abilityLabel} mod).</div>`;
      } else if (acqType === 'prepared_list') {
        acqDescription = `<div class="text-xs text-violet-300 mt-1">✨ <strong>Prepared Spells:</strong> Choose <strong>${numSelectable}</strong> prepared spells from the ${selectedClassObj.name} spell list.</div>`;
      } else {
        acqDescription = `<div class="text-xs text-emerald-300 mt-1">🎵 <strong>Known Spells:</strong> Choose <strong>${numSelectable}</strong> spells you know permanently.</div>`;
      }

      info.innerHTML = `
        <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 text-sm space-y-1">
          <div class="font-bold text-yellow-500">${selectedClassObj.name} Spellcasting</div>
          <p class="text-xs text-gray-300">Ability: <strong>${abilityLabel}</strong> (mod: <strong>${abilityMod >= 0 ? '+' : ''}${abilityMod}</strong>) | Save DC: <strong>${spellContextData.dc || '8+'}</strong> | Attack Bonus: <strong>+${spellContextData.attackBonus || 2}</strong></p>
          ${acqDescription}
        </div>
      `;

      // Render Cantrips
      if (spellContextData.cantripList && spellContextData.cantripList.length > 0) {
        if (cantripSec) cantripSec.style.display = 'block';
        renderCantripPickGrid(spellContextData.cantripList, spellContextData.maxCantrips || 0);
      } else {
        if (cantripSec) cantripSec.style.display = 'none';
      }

      // Render spells grouped by level (1..maxSpellLevel)
      const levelKeys = Object.keys(spellContextData.spellList || {})
        .map(Number)
        .filter(k => k > 0)
        .sort((a, b) => a - b);
      const totalSpells = levelKeys.reduce((sum, k) => sum + (spellContextData.spellList[k] || []).length, 0);

      if (totalSpells > 0) {
        if (spellPickSec) spellPickSec.style.display = 'block';
        renderSpellPickGrid(spellContextData.spellList, numSelectable);
      } else if (gainsSpellcastingLater) {
        if (spellPickSec) spellPickSec.style.display = 'block';
        document.getElementById('spellList').innerHTML = `
          <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-xs text-sky-300">
            <strong>${selectedClassObj.name}</strong> gains spellcasting at <strong>level 2</strong> — you have no spells to prepare at this level.
          </div>
        `;
      } else {
        if (spellPickSec) spellPickSec.style.display = 'none';
      }

    } catch (err) {
      console.error(err);
      info.innerHTML = '<div class="p-4 bg-slate-900/60 rounded-xl border border-slate-800 text-sm text-gray-400">Standard spellcasting will be initialized automatically.</div>';
    }
  }

  // ── Spell picker helpers ──────────────────────────────────────
  const SPELL_SCHOOLS = {
    A: { full: 'Abjuration', color: '#5b8dd9' },
    C: { full: 'Conjuration', color: '#5bbf8a' },
    D: { full: 'Divination', color: '#d9b85b' },
    E: { full: 'Enchantment', color: '#b06fd9' },
    V: { full: 'Evocation', color: '#d97b5b' },
    I: { full: 'Illusion', color: '#5bd4c4' },
    N: { full: 'Necromancy', color: '#9aa3ad' },
    T: { full: 'Transmutation', color: '#6fb3d9' },
  };

  function spellSchoolInfo(code) {
    if (!code) return { full: 'Unknown', color: '#9aa3ad' };
    const upper = String(code).toUpperCase();
    if (window.Parser && typeof window.Parser.spSchoolAbvToFull === 'function') {
      return { full: window.Parser.spSchoolAbvToFull(upper) || code, color: SPELL_SCHOOLS[upper]?.color || '#9aa3ad' };
    }
    return { full: SPELL_SCHOOLS[upper]?.full || code, color: SPELL_SCHOOLS[upper]?.color || '#9aa3ad' };
  }

  function spellTimeShort(s) {
    if (window.Parser && s.time && s.time.length) {
      return window.Parser.spTimeListToFull(s.time, s.meta, { styleHint: 'classic' });
    }
    if (s.time && s.time[0]) return `${s.time[0].number || 1} ${s.time[0].unit}`;
    return '';
  }

  function spellComponentsShort(s) {
    if (window.Parser && s.components) {
      return window.Parser.spComponentsToFull(s.components, 0);
    }
    if (!s.components) return '';
    const parts = [];
    if (s.components.v) parts.push('V');
    if (s.components.s) parts.push('S');
    if (s.components.m) parts.push('M');
    return parts.join(', ');
  }

  function buildSpellCard(spell, level, isSelected, onToggle) {
    const school = spellSchoolInfo(spell.school);
    const card = document.createElement('div');
    card.className = `spell-card ${isSelected ? 'selected' : ''}`;
    card.style.setProperty('--spell-school-color', school.color);
    card.title = spell.source ? `Source: ${(window.Parser && window.Parser.sourceJsonToFull) ? window.Parser.sourceJsonToFull(spell.source) : spell.source}` : '';

    const pips = level === 0
      ? '<span class="spell-pips">✦</span>'
      : `<span class="spell-pips">${'◆'.repeat(level)}</span>`;

    const timeStr = spellTimeShort(spell);
    const compStr = spellComponentsShort(spell);
    const chips = [];
    if (timeStr) chips.push(`<span class="spell-meta-chip">⚡ ${timeStr}</span>`);
    if (compStr) chips.push(`<span class="spell-meta-chip">✦ ${compStr}</span>`);
    if (spell.ritual) chips.push(`<span class="spell-meta-chip spell-meta-chip--ritual">Ritual</span>`);
    if (spell.concentration) chips.push(`<span class="spell-meta-chip spell-meta-chip--concentration">Conc.</span>`);

    card.innerHTML = `
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="font-bold text-gray-100 text-xs leading-snug pr-5">${spell.name}</div>
          <div class="text-[10px] text-gray-500 mt-0.5">${school.full}</div>
        </div>
        ${pips}
      </div>
      ${chips.length ? `<div class="spell-meta">${chips.join('')}</div>` : ''}
      <span class="spell-card-check">✓</span>
    `;

    card.onclick = onToggle;
    return card;
  }

  let spellFilterQuery = '';

  function renderSpellSummary(spellListByLevel, maxSpells) {
    const container = document.getElementById('spellSummary');
    if (!container) return;
    container.innerHTML = '';

    const counter = document.getElementById('spellCounter');
    if (counter) counter.textContent = `${selectedSpells.length} / ${maxSpells || '∞'} selected`;

    if (selectedSpells.length === 0) return;

    selectedSpells.forEach((sp, idx) => {
      const chip = document.createElement('span');
      chip.className = 'spell-summary-chip';
      chip.innerHTML = `${sp.name} (L${sp.level}) <button type="button" title="Remove">✕</button>`;
      chip.querySelector('button').onclick = () => {
        selectedSpells.splice(idx, 1);
        renderSpellPickGrid(spellListByLevel, maxSpells);
      };
      container.appendChild(chip);
    });
  }

  function renderCantripPickGrid(cantrips, maxCantrips) {
    const container = document.getElementById('cantripList');
    const counter = document.getElementById('cantripCounter');
    if (!container) return;

    if (counter) counter.textContent = `${selectedCantrips.length} / ${maxCantrips || '∞'} selected`;

    container.innerHTML = '';
    cantrips.forEach(c => {
      const isSelected = selectedCantrips.some(sc => sc.name === c.name);
      const card = buildSpellCard(c, 0, isSelected, () => {
        const idx = selectedCantrips.findIndex(sc => sc.name === c.name);
        if (idx >= 0) {
          selectedCantrips.splice(idx, 1);
        } else {
          if (maxCantrips > 0 && selectedCantrips.length >= maxCantrips) {
            alert(`You can only select up to ${maxCantrips} cantrips.`);
            return;
          }
          selectedCantrips.push({ name: c.name, source: c.source || 'PHB' });
        }
        renderCantripPickGrid(cantrips, maxCantrips);
      });
      container.appendChild(card);
    });
  }

  function renderSpellPickGrid(spellListByLevel, maxSpells) {
    const container = document.getElementById('spellList');
    if (!container) return;

    const levelKeys = Object.keys(spellListByLevel || {})
      .map(Number)
      .filter(k => k > 0)
      .sort((a, b) => a - b);

    renderSpellSummary(spellListByLevel, maxSpells);

    container.innerHTML = '';
    const query = spellFilterQuery.trim().toLowerCase();

    levelKeys.forEach(lvl => {
      const allSpells = spellListByLevel[lvl] || [];
      if (allSpells.length === 0) return;
      const spells = query ? allSpells.filter(s => s.name.toLowerCase().includes(query)) : allSpells;
      if (spells.length === 0) return;

      const section = document.createElement('div');
      const head = document.createElement('div');
      head.className = 'spell-level-head mb-2';
      head.innerHTML = `
        <span class="spell-pips">${'◆'.repeat(lvl)}</span>
        <span class="font-bold text-yellow-500 text-sm">Level ${lvl} Spells</span>
        <span class="spell-count-badge">${spells.length}${query ? ` / ${allSpells.length}` : ''}</span>
      `;
      section.appendChild(head);

      const grid = document.createElement('div');
      grid.className = 'creator-pick-grid creator-pick-grid--spells';

      spells.forEach(s => {
        const isSelected = selectedSpells.some(ss => ss.name === s.name && ss.level === lvl);
        const card = buildSpellCard(s, lvl, isSelected, () => {
          const idx = selectedSpells.findIndex(ss => ss.name === s.name && ss.level === lvl);
          if (idx >= 0) {
            selectedSpells.splice(idx, 1);
          } else {
            if (maxSpells > 0 && selectedSpells.length >= maxSpells) {
              alert(`You can only select up to ${maxSpells} spells.`);
              return;
            }
            selectedSpells.push({ name: s.name, source: s.source || 'PHB', level: lvl });
          }
          renderSpellPickGrid(spellListByLevel, maxSpells);
        });
        grid.appendChild(card);
      });

      section.appendChild(grid);
      container.appendChild(section);
    });

    if (container.childElementCount === 0) {
      container.innerHTML = `
        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-xs text-gray-400">
          No spells match “${spellFilterQuery}”.
        </div>
      `;
    }
  }

  const spellSearchEl = document.getElementById('spellSearch');
  if (spellSearchEl) {
    spellSearchEl.addEventListener('input', () => {
      spellFilterQuery = spellSearchEl.value;
      if (spellContextData && spellContextData.spellList) {
        const maxSpells = spellContextData.numSelectable || spellContextData.maxSpells || 0;
        renderSpellPickGrid(spellContextData.spellList, maxSpells);
      }
    });
  }

  // Get current form data payload
  function getFormPayload() {
    const payload = {
      name: document.getElementById('name')?.value || 'Unnamed Hero',
      race: selectedRaceObj ? selectedRaceObj.name : '',
      raceSource: selectedRaceObj ? (selectedRaceObj.source || 'PHB') : 'PHB',
      className: selectedClassObj ? selectedClassObj.name : '',
      classSource: selectedClassObj ? (selectedClassObj.source || 'PHB') : 'PHB',
      level: parseInt(document.getElementById('level')?.value) || 1,
      background: selectedBackgroundObj ? selectedBackgroundObj.name : '',
      backgroundSource: selectedBackgroundObj ? (selectedBackgroundObj.source || 'PHB') : 'PHB',
      alignment: document.getElementById('alignment')?.value || 'Neutral',
      stats: {
        strength: parseInt(document.getElementById('stat_strength')?.value) || 10,
        dexterity: parseInt(document.getElementById('stat_dexterity')?.value) || 10,
        constitution: parseInt(document.getElementById('stat_constitution')?.value) || 10,
        intelligence: parseInt(document.getElementById('stat_intelligence')?.value) || 10,
        wisdom: parseInt(document.getElementById('stat_wisdom')?.value) || 10,
        charisma: parseInt(document.getElementById('stat_charisma')?.value) || 10
      },
      feats: selectedFeats,
      selectedCantrips: selectedCantrips,
      selectedSpells: selectedSpells,
      equipmentChoices: selectedEquipmentChoices
    };

    if (selectedSubraceObj) {
      payload.subrace = selectedSubraceObj.name;
      payload.subraceSource = selectedSubraceObj.source || selectedRaceObj?.source;
    }

    if (selectedSubclassObj) {
      payload.subclass = selectedSubclassObj.name;
      payload.subclassSource = selectedSubclassObj.source || selectedClassObj?.source;
    }

    return payload;
  }

  // Step 8: Dynamic Review Step
  function renderReviewStep() {
    const name = document.getElementById('name')?.value || 'Unnamed Hero';
    const raceName = selectedRaceObj ? selectedRaceObj.name : 'Unselected Race';
    const subraceName = selectedSubraceObj ? ` (${selectedSubraceObj.name})` : '';
    const className = selectedClassObj ? selectedClassObj.name : 'Unselected Class';
    const subclassName = selectedSubclassObj ? ` (${selectedSubclassObj.name})` : '';
    const level = document.getElementById('level')?.value || 1;
    const bgName = selectedBackgroundObj ? selectedBackgroundObj.name : 'Unselected Background';

    const summaryGrid = document.getElementById('review-summary-grid');
    if (summaryGrid) {
      summaryGrid.innerHTML = `
        <div><span class="text-gray-500 block text-xs">Name:</span> <strong>${name}</strong></div>
        <div><span class="text-gray-500 block text-xs">Race:</span> <strong>${raceName}${subraceName}</strong></div>
        <div><span class="text-gray-500 block text-xs">Class:</span> <strong>${className}${subclassName} Lvl ${level}</strong></div>
        <div><span class="text-gray-500 block text-xs">Background:</span> <strong>${bgName}</strong></div>
        <div><span class="text-gray-500 block text-xs">Feats Selected:</span> <strong>${selectedFeats.length > 0 ? selectedFeats.map(f => f.name).join(', ') : 'None'}</strong></div>
        <div><span class="text-gray-500 block text-xs">Cantrips Selected:</span> <strong>${selectedCantrips.length > 0 ? selectedCantrips.map(c => c.name).join(', ') : 'None'}</strong></div>
        <div><span class="text-gray-500 block text-xs">Spells Selected:</span> <strong>${selectedSpells.length > 0 ? selectedSpells.map(s => s.name).join(', ') : 'None'}</strong></div>
        <div><span class="text-gray-500 block text-xs">Ability Mode:</span> <strong class="capitalize">${abilityMode}</strong></div>
      `;
    }

    const conScore = parseInt(document.getElementById('stat_constitution')?.value) || 10;
    const conMod = Math.floor((conScore - 10) / 2);
    const hdFaces = selectedClassObj?.hd?.faces || 8;
    const estHp = hdFaces + conMod;

    // Calculate Stat Increases breakdown
    const asiTotals = { strength: 0, dexterity: 0, constitution: 0, intelligence: 0, wisdom: 0, charisma: 0 };
    const extractASIs = (dataObj) => {
      if (dataObj && dataObj.ability) {
        const abList = Array.isArray(dataObj.ability) ? dataObj.ability : [dataObj.ability];
        abList.forEach(abObj => {
          if (typeof abObj === 'object') {
            Object.entries(abObj).forEach(([st, val]) => {
              if (st !== 'choose' && typeof val === 'number') {
                const key = ABIL_MAP[st.toLowerCase()] || st.toLowerCase();
                if (asiTotals.hasOwnProperty(key)) asiTotals[key] += val;
              }
            });
          }
        });
      }
    };

    extractASIs(selectedRaceObj);
    extractASIs(selectedSubraceObj);
    extractASIs(selectedBackgroundObj);
    selectedFeats.forEach(f => extractASIs(f));

    let statBreakdownHTML = '<div class="grid grid-cols-2 md:grid-cols-3 gap-2 mt-2">';
    ABILITIES.forEach(st => {
      const baseVal = parseInt(document.getElementById(`stat_${st}`)?.value) || 10;
      const bonus = asiTotals[st] || 0;
      const total = baseVal + bonus;
      const mod = Math.floor((total - 10) / 2);
      const modStr = (mod >= 0 ? '+' : '') + mod;
      const dispName = st.charAt(0).toUpperCase() + st.slice(1, 3).toUpperCase();
      statBreakdownHTML += `
        <div class="p-2 bg-slate-900/80 rounded border border-slate-800 flex justify-between items-center text-xs">
          <span class="font-bold text-gray-300">${dispName}</span>
          <span><strong class="text-white">${total}</strong> <span class="text-yellow-400">(${modStr})</span> ${bonus > 0 ? `<span class="text-emerald-400 text-[10px]">(+${bonus})</span>` : ''}</span>
        </div>
      `;
    });
    statBreakdownHTML += '</div>';

    // Feat Descriptions Breakdown
    let featsBreakdownHTML = '';
    if (selectedFeats.length > 0) {
      featsBreakdownHTML += '<div class="mt-3"><strong class="text-yellow-500 block text-xs mb-1 uppercase tracking-wider">Feat Descriptions & Benefits</strong><div class="space-y-2">';
      selectedFeats.forEach(f => {
        const featDesc = f.entries ? flattenEntries(f.entries) : (f.description || 'Feat benefit.');
        featsBreakdownHTML += `
          <div class="p-2.5 bg-slate-900/80 rounded border border-slate-800 text-xs">
            <div class="flex justify-between items-center mb-1">
              <strong class="text-indigo-400">${f.name}</strong>
              <span class="text-[10px] text-gray-500 bg-slate-800 px-1.5 py-0.5 rounded">${f.source || 'PHB'}</span>
            </div>
            <div class="text-gray-300 leading-relaxed text-[11px]">${featDesc}</div>
          </div>
        `;
      });
      featsBreakdownHTML += '</div></div>';
    }

    // Auto-granted Traits Breakdown
    let traitsBreakdownHTML = '';
    const raceEntries = selectedRaceObj?.entries ? flattenEntries(selectedRaceObj.entries) : '';
    if (raceEntries) {
      traitsBreakdownHTML += `
        <div class="mt-3">
          <strong class="text-yellow-500 block text-xs mb-1 uppercase tracking-wider">Racial Traits & Heritage (${raceName})</strong>
          <div class="p-2.5 bg-slate-900/80 rounded border border-slate-800 text-xs text-gray-300 leading-relaxed max-h-[140px] overflow-y-auto">${raceEntries}</div>
        </div>
      `;
    }

    // Granted Spells Breakdown (Background / Feats / Race)
    let spellsBreakdownHTML = '';
    const allSpellSources = [selectedRaceObj, selectedBackgroundObj, ...selectedFeats].filter(Boolean);
    const detectedSpells = [];
    allSpellSources.forEach(entity => {
      if (entity.additionalSpells) {
        entity.additionalSpells.forEach(addSp => {
          if (addSp.expanded) {
            Object.values(addSp.expanded).forEach(list => {
              if (Array.isArray(list)) {
                list.forEach(sStr => {
                  const spName = typeof sStr === 'string' ? sStr.split('|')[0].replace(/#c$/i, '') : '';
                  if (spName) detectedSpells.push({ name: spName, source: entity.name, type: 'Expanded Spell' });
                });
              }
            });
          }
          ["innate", "known", "prepared"].forEach(key => {
            if (addSp[key]) {
              const findSpells = (obj) => {
                if (typeof obj === 'string') {
                  const spName = obj.split('|')[0].replace(/#c$/i, '');
                  if (spName) detectedSpells.push({ name: spName, source: entity.name, type: 'Innate / Granted' });
                } else if (Array.isArray(obj)) {
                  obj.forEach(findSpells);
                } else if (typeof obj === 'object') {
                  if (obj.choose) {
                    detectedSpells.push({ name: `Choice: ${obj.choose}`, source: entity.name, type: 'Selectable Spell Choice' });
                  } else {
                    Object.values(obj).forEach(findSpells);
                  }
                }
              };
              findSpells(addSp[key]);
            }
          });
        });
      }
    });

    if (detectedSpells.length > 0) {
      spellsBreakdownHTML += `
        <div class="mt-3">
          <strong class="text-purple-400 block text-xs mb-1 uppercase tracking-wider">Spells & Spell Lists (Background / Feat / Race)</strong>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-1.5 max-h-[140px] overflow-y-auto pr-1">
            ${detectedSpells.map(s => `
              <div class="p-1.5 bg-purple-950/40 rounded border border-purple-800/40 text-[11px] flex justify-between items-center">
                <span class="text-purple-200 font-medium">✨ ${s.name}</span>
                <span class="text-[9px] text-gray-400 italic">${s.source} (${s.type})</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    const cerberusBox = document.getElementById('cerberus-review-box');
    if (cerberusBox) {
      cerberusBox.innerHTML = `
        <div class="flex items-center gap-2 text-emerald-400 font-bold mb-2">
          <span>✓ Cerberus Watchdog Inspection & Source Analysis</span>
        </div>
        <div class="text-[11px] text-gray-300 space-y-2">
          <div>• <strong>Hit Points:</strong> ${estHp} HP (${hdFaces} Hit Die + ${conMod >= 0 ? '+' : ''}${conMod} CON)</div>
          <div>• <strong>Ability Score & Stat Increase Breakdown:</strong></div>
          ${statBreakdownHTML}
          ${spellsBreakdownHTML}
          ${featsBreakdownHTML}
          ${traitsBreakdownHTML}
        </div>
      `;
    }

    // Live JSON Preview Panel
    const jsonPayload = getFormPayload();
    const preEl = document.getElementById('characterJson');
    if (preEl) {
      preEl.textContent = JSON.stringify(jsonPayload, null, 2);
    }
  }

  // Form Submit Handler
  document.getElementById('characterForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!selectedRaceObj || !selectedClassObj || !selectedBackgroundObj) {
      alert('Please complete Race, Class, and Background selections before creating your hero.');
      return;
    }

    const payload = getFormPayload();

    try {
      const response = await fetch('/createCharacter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (response.ok) {
        if (result.id) window.location.href = `/character/${result.id}`;
      } else {
        alert('Error creating character: ' + (result.error || 'Unknown error'));
      }
    } catch (err) {
      console.error(err);
      alert('Submission failed. Check your connection.');
    }
  });

  // Initialization
  document.addEventListener('DOMContentLoaded', () => {
    renderRaceCards();
    renderClassCards();
    renderBackgroundCards();
    renderFeatCards();
    window.updateWizardUI();
  });
</script>

<%- include('partials/footer.ejs') %>