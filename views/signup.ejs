<%- include('partials/header') %>

    <main class="auth-page">
        <div class="auth-card">
            <div class="auth-card-header">
                <div class="obsidian-tag" style="margin-bottom: 6px;">#auth/register</div>
                <h1>Create Vault Account</h1>
            </div>
            <div class="auth-card-body">
                <% if (messages.error) { %>
                    <div class="flash-msg error">
                        <%= messages.error %>
                    </div>
                <% } %>

                <form action="/signup" method="POST" class="auth-form">
                    <input type="text" name="username" placeholder="Username" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit" class="rpg-btn rpg-btn-primary" style="justify-content: center;">Create Account</button>
                </form>
            </div>
            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Login</a></p>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>